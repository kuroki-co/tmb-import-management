  "info": {
    "title": "TMB API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tmb_session"
      }
    },
    "schemas": {
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "CreateFriDto": {
        "type": "object",
        "properties": {
          "documentType": {
            "type": "string",
            "enum": [
              "DNI",
              "RUC",
              "CE",
              "Pasaporte"
            ]
          },
          "documentNumber": {
            "type": "string"
          },
          "issuingCountry": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "representative": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "department": {
            "type": "string",
            "enum": [
              "Amazonas",
              "Áncash",
              "Apurímac",
              "Arequipa",
              "Ayacucho",
              "Cajamarca",
              "Callao",
              "Cusco",
              "Huancavelica",
              "Huánuco",
              "Ica",
              "Junín",
              "La Libertad",
              "Lambayeque",
              "Lima",
              "Loreto",
              "Madre de Dios",
              "Moquegua",
              "Pasco",
              "Piura",
              "Puno",
              "San Martín",
              "Tacna",
              "Tumbes",
              "Ucayali"
            ]
          },
          "mobile": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "fuel": {
            "type": "string",
            "enum": [
              "Gasolina",
              "Diésel",
              "Híbrido",
              "Eléctrico",
              "No aplica"
            ]
          },
          "transmission": {
            "type": "string",
            "enum": [
              "Manual o mecánica (MT)",
              "Automática convencional (AT)",
              "Manual automatizada (AMT)",
              "Automática de doble embrague (DCT)",
              "Transmisión continuamente variable (CVT)",
              "Transmisión eléctrica (EV / e-Axle)",
              "Transmisión híbrida (e-CVT / DHT)"
            ]
          },
          "power": {
            "type": "string"
          },
          "autonomy": {
            "type": "number"
          },
          "equipment": {
            "type": "string"
          },
          "budget": {
            "type": "number"
          },
          "purchaseDate": {
            "type": "string"
          },
          "payment": {
            "type": "string",
            "enum": [
              "Contado",
              "Financiado"
            ]
          },
          "alternatives": {
            "type": "boolean"
          },
          "usage": {
            "type": "string",
            "enum": [
              "Personal",
              "Comercial",
              "Industrial"
            ]
          },
          "originCountry": {
            "type": "string"
          },
          "supplier": {
            "type": "string"
          },
          "observations": {
            "type": "string"
          },
          "declaration": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "documentType",
          "documentNumber",
          "name",
          "department",
          "mobile",
          "brand",
          "model",
          "year",
          "quantity",
          "fuel",
          "transmission",
          "budget",
          "purchaseDate",
          "payment",
          "alternatives",
          "usage",
          "declaration"
        ]
      },
      "ReceiptDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "receiptToken": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "receiptToken"
        ]
      },
      "FriDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pendiente a revisar",
              "En revisión",
              "Cotizado",
              "Confirmado a compra"
            ]
          },
          "code": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CreateFriDto"
          }
        },
        "required": [
          "id",
          "createdAt",
          "status",
          "code",
          "data"
        ]
      }
    }
  }
}
